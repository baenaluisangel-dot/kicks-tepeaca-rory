# AgentKit — Variables de entorno
# Copia este archivo como .env y llena tus datos:
#   cp .env.example .env
#
# Claude Code te ayuda a llenar estos valores durante el setup.
# NUNCA subas el archivo .env a GitHub.

# ── Anthropic ──────────────────────────────────────────────
# Obtener en: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=

# Modelo de Claude. Default: claude-sonnet-5-5
#   claude-opus-5-5   el mas capaz             $4 / $20 por millon de tokens
#   claude-sonnet-5-5 el balanceado (default)  $2 / $10
#   claude-haiku-5-5  el mas barato y rapido   $0.10 / $0.50
ANTHROPIC_MODEL=claude-sonnet-5-5

# Esfuerzo de razonamiento: low | medium | high
# Dejalo vacio para no enviar el parametro (los modelos viejos no lo aceptan).
ANTHROPIC_EFFORT=low

# Opcional. Tope de tokens por respuesta, default 4096. Ojo: en los modelos
# actuales el razonamiento interno tambien cuenta contra este tope.
# ANTHROPIC_MAX_TOKENS=4096

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: zernio | meta
WHATSAPP_PROVIDER=

# ── Zernio (si WHATSAPP_PROVIDER=zernio) ───────────────────
# Crear cuenta y conectar WhatsApp en: https://zernio.link/enrique-rocha
# La API key se genera en Settings -> API Keys (empieza con "sk_")
ZERNIO_API_KEY=
# El webhook secret lo inventas tu. Sirve para verificar que los
# mensajes vienen de Zernio y no de cualquiera que sepa tu URL.
ZERNIO_WEBHOOK_SECRET=
# Opcional: solo se usa para chequear la conexion al arrancar.
# Para responder, el account id sale del propio webhook.
ZERNIO_ACCOUNT_ID=
# Opcional: solo si necesitas apuntar a otra URL. Dejala comentada para usar
# la de siempre, https://zernio.link/enrique-rocha/api/v1
# ZERNIO_BASE_URL=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ─────────────
# Configurar en: https://developers.facebook.com
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=agentkit-verify
# META_APP_SECRET=
# META_API_VERSION=v25.0

# ── Servidor ───────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ──────────────────────────────────────────
# Local (SQLite):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Produccion (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── Avisos y aprobaciones por Telegram ─────────────────────
# El canal por el que los agentes le piden permiso a Luisito. Sin estas
# variables el agente corre igual, pero nadie se entera de lo que queda detenido.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Secreto del webhook: lo inventas tu, cualquier texto largo y aleatorio sirve.
# Es la primera de las dos barreras del endpoint /telegram, que aprueba decisiones
# de negocio; la segunda es que el chat sea el de arriba.
# No hay que registrar nada a mano: la app llama a setWebhook al arrancar, con el
# token que ya tiene aqui. Si falta este secreto, no se registra y los botones no
# llegan a ningun lado.
TELEGRAM_WEBHOOK_SECRET=

# Hora (0-23, hora de Mexico) del resumen diario. Con entregas de 1 a 8 PM,
# el resumen util es el de la manana: dice que hacer hoy, no que paso ayer.
HORA_RESUMEN=7

# Cada cuantos segundos el despachador revisa la cola de envio. 300 = 5 minutos.
# Mas seguido no sirve de mucho: los seguimientos se programan en horas, no en minutos.
DESPACHADOR_INTERVALO=300
